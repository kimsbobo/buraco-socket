# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=*

# Socket.IO Configuration
PING_TIMEOUT=60000
PING_INTERVAL=25000

# Game Configuration
MAX_PLAYERS_PER_ROOM=2
MIN_PLAYERS_TO_START=2
INACTIVITY_TIMEOUT=1800000
ROOM_CLEANUP_INTERVAL=300000
MIN_POINTS_TO_GO_DOWN=50

# Redis Configuration
# Required when NODE_ENV=production.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ADAPTER_ENABLED=false

# Logging Configuration
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_FILE=false
LOG_DIR=./logs

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
WEBHOOK_SECRET=0e2fc0a3f9c334dcb2e490cf5ccd42bdfd2234da339aea858b952e0904fca2f4
BACKEND_URL=https://dev.app.wliveapp.com
# 8080 is taken by wlive-nginx on this host.
LB_PORT=8090
